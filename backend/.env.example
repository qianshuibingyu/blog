# Django 基础配置
DJANGO_SECRET_KEY=请替换为本地开发密钥
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# SQLite 数据库
DATABASE_PATH=./data/db.sqlite3

# Chroma 本地持久化目录
CHROMA_PERSIST_DIRECTORY=./data/chroma

# LangExtract/chat 使用的 OpenAI-compatible 模型服务
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# 本地 Sentence Transformers Embedding；不会调用远程 /embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_RETRIES=2    # 远程 provider 临时错误的最大重试次数
EMBEDDING_RETRY_BACKOFF_SECONDS=1      # 指定退避基础秒数

# 文章切分和检索配置
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=32
SIMILARITY_THRESHOLD=0.75
MAX_RETRIEVED_CHUNKS=5
MAX_CONTEXT_CHARS=8000
LLM_TIMEOUT_SECONDS=30

# 单篇文章进入清洗器前允许的最大字符数
CONTENT_MAX_LENGTH=500000
# 去掉常见 Markdown 标记后要求保留的最小正文长度
CONTENT_MIN_LENGTH=10

# 单个片段允许的最大 Unicode 字符数
RAG_CHUNK_SIZE=1000
# 相邻片段的最大重叠字符数
RAG_CHUNK_OVERLAP=150
# 非首尾片段低于该长度时，尝试和前一片段合并
RAG_MIN_CHUNK_SIZE=40
# 单篇文章最多生成的片段数量
RAG_MAX_CHUNKS=1000

# 使用固定的 coleection 名称
CHROMA_COLLECTION_NAME=ownerblog_articles